diff --git a/Sources/Zametki/Localization.swift b/Sources/Zametki/Localization.swift
new file mode 100644
index 0000000..09a112e
--- /dev/null
+++ b/Sources/Zametki/Localization.swift
@@ -0,0 +1,37 @@
+import AppKit
+
+/// Локализация. Ключи - русские строки (язык разработки);
+/// переводы лежат в Resources/<язык>.lproj/Localizable.strings (ru, en).
+/// Язык выбирается в настройках («Как в системе», English, Русский) и применяется при запуске.
+enum Localization {
+    static let key = "appLanguage"          // "auto" | "en" | "ru"
+    static let available = ["en", "ru"]
+
+    /// Что было выбрано в настройках на момент запуска.
+    static let launchChoice: String = UserDefaults.standard.string(forKey: key) ?? "auto"
+
+    /// Язык интерфейса: явный выбор или, при «Как в системе», язык macOS из доступных (иначе English).
+    static let code: String = {
+        if available.contains(launchChoice) { return launchChoice }
+        if let system = Bundle.main.preferredLocalizations.first, available.contains(system) { return system }
+        return "en"
+    }()
+
+    static var isRussian: Bool { code == "ru" }
+
+    static let bundle: Bundle = Bundle.main.path(forResource: code, ofType: "lproj").flatMap { Bundle(path: $0) } ?? .main
+
+    /// Перезапуск приложения, чтобы новый язык подхватили все окна и меню.
+    static func relaunch() {
+        let task = Process()
+        task.executableURL = URL(fileURLWithPath: "/bin/sh")
+        task.arguments = ["-c", "sleep 0.6; open \"$0\"", Bundle.main.bundlePath]
+        try? task.run()
+        NSApp.terminate(nil)
+    }
+}
+
+/// Строка интерфейса на выбранном языке.
+func L(_ key: String) -> String {
+    Localization.bundle.localizedString(forKey: key, value: nil, table: nil)
+}
